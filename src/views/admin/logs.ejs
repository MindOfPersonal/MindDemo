<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logs - MindDemo</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="admin-page">
    <div class="sidebar">
        <div class="sidebar-header">
            <span class="logo">MindDemo</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-link">Dashboard</a>
            <div class="nav-group">
                <span class="nav-label">Demos</span>
                <a href="/admin/demos" class="nav-link">All Demos</a>
                <a href="/admin/demos/create" class="nav-link">Create Demo</a>
            </div>
            <a href="/admin/logs" class="nav-link active">Logs</a>
            <a href="/admin/settings" class="nav-link">Settings</a>
            <a href="/api/admin/logout" class="nav-link logout">Logout</a>
        </nav>
    </div>
    <main class="main-content">
        <header class="top-bar">
            <div class="user-info">
                <span>Admin: Admin</span>
            </div>
        </header>
        <h1 style="font-size: 24px; margin-bottom: 24px;">System Logs</h1>
        <div class="card">
            <div style="max-height: 600px; overflow-y: auto; font-family: 'Fira Code', monospace; font-size: 12px;" id="logs-container">
                Loading logs...
            </div>
        </div>
    </main>
    <script>
    async function loadLogs() {
        try {
            const res = await fetch('/api/admin/demos/logs', { credentials: 'include' });
            if (!res.ok) {
                document.getElementById('logs-container').innerHTML =
                    '<div style="color: var(--text-secondary);">Unable to load logs (' + res.status + ').</div>';
                return;
            }
            const logs = await res.json();
            const container = document.getElementById('logs-container');
            if (!logs.length) {
                container.innerHTML = '<div style="color: var(--text-secondary);">No logs yet.</div>';
                return;
            }
            container.innerHTML = logs.map(l =>
                `<div style="padding: 4px 0; border-bottom: 1px solid var(--border);">[${l.created_at}] [${l.level}] ${l.demo_name || 'SYSTEM'}: ${l.message}</div>`
            ).join('');
        } catch (err) {
            document.getElementById('logs-container').innerHTML =
                '<div style="color: var(--text-secondary);">Error loading logs.</div>';
        }
    }
    loadLogs();
    setInterval(loadLogs, 10000);
    </script>
</body>
</html>
