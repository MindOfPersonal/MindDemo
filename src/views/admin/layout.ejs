<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - MindDemo</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
</head>
    <body class="admin-page">
    <input type="checkbox" id="navToggle" class="nav-toggle" hidden>
        <aside class="sidebar">
        <div class="sidebar-header">
            <a href="/admin/dashboard" class="logo"><img src="/img/logo.png" alt="MindDevelopment logo" class="logo-img"><span>MindDemo</span></a>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
            <div class="nav-group">
                <a href="/admin/demos" class="nav-link <%= activePage === 'demos' ? 'active' : '' %>">All Demos</a>
                <a href="/admin/demos/create" class="nav-link <%= activePage === 'create' ? 'active' : '' %>">Create Demo</a>
            </div>
            <a href="/admin/servers" class="nav-link <%= activePage === 'servers' ? 'active' : '' %>">Servers</a>
            <a href="/admin/logs" class="nav-link <%= activePage === 'logs' ? 'active' : '' %>">Logs</a>
            <a href="/admin/settings" class="nav-link <%= activePage === 'settings' ? 'active' : '' %>">Settings</a>
            <a href="/api/admin/logout" class="nav-link logout">Logout</a>
        </nav>
    </aside>
    <main class="main-content">
        <header class="top-bar">
            <label class="menu-btn" for="navToggle" aria-label="Toggle navigation">☰</label>
            <div class="user-info">
                <span>Admin: <%= username %></span>
            </div>
        </header>
        <div class="content">
            <%- body %>
        </div>
    </main>
</body>
</html>
