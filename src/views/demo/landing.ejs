<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= demo.name %> - MindDemo</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .demo-hero { display:flex; justify-content:space-between; align-items:center; gap:12px; }
        .demo-iframe { width:100%; height:70vh; border:1px solid #2a344c; border-radius:12px; background:#0b0f1a; }
        .demo-controls { display:flex; gap:8px; flex-wrap:wrap; margin-top:16px; }
        .pill { font-size:12px; padding:4px 10px; border-radius:999px; }
        .btn-warning { background:#7239ea; color:#fff; }
        .btn-warning:hover { background:#622fd1; }
        .meta { color:var(--muted, #8a94a6); font-size:13px; }
    </style>
</head>
<body class="admin-page">
    <div class="main-content">
        <header class="top-bar">
            <div class="user-info"><span><%= demo.name %></span></div>
        </header>

        <div class="card">
            <div class="demo-hero">
                <h2 style="margin:0;"><%= demo.name %></h2>
                <span class="status-badge status-<%= demo.status %>"><%= demo.status.toUpperCase() %></span>
            </div>
            <p class="subtitle" style="margin:8px 0 0 0; color:var(--muted, #8a94a6);">
                <%= demo.description || 'A temporary, isolated demo environment that resets on inactivity.' %>
            </p>

            <% if (demo.show_credentials) { %>
            <div class="banner" style="margin-top:12px;">
                <strong>Demo credentials:</strong> <code>demo / demo123</code> &middot; This environment is temporary and resets when idle.
            </div>
            <% } %>

            <div class="demo-controls" id="controls">
                <button id="startBtn" class="btn btn-success" style="<%= demo.status === 'running' ? 'display:none' : '' %>">Start demo</button>
                <button id="stopBtn" class="btn btn-warning" style="<%= demo.status === 'running' ? '' : 'display:none' %>">Stop</button>
                <button id="resetBtn" class="btn btn-secondary" style="<%= demo.status === 'running' ? '' : 'display:none' %>">Reset session</button>
                <span class="pill" style="background:#143a27;color:#6ee7b7;">Status: <%= demo.status %></span>
                <a href="/admin/login" class="btn btn-sm btn-outline" style="margin-left:auto;">Admin login</a>
            </div>
        </div>

        <div id="liveWrap" class="card" style="margin-top:16px;<%= demo.status === 'running' ? '' : 'display:none' %>">
            <div class="demo-hero">
                <h3 style="margin:0;">Live view</h3>
                <span class="meta" id="liveStatus">Loading demo…</span>
            </div>
            <div style="margin-top:12px;">
                <iframe id="liveFrame" class="demo-iframe"
                        src="<%= demo.status === 'running' ? `/demo/${demo.slug}/live` : 'about:blank' %>"
                        loading="lazy"
                        title="<%= demo.name %> live demo"></iframe>
            </div>
        </div>
    </div>

    <script>
        const slug = "<%= demo.slug %>";
        const startBtn = document.getElementById('startBtn');
        const stopBtn  = document.getElementById('stopBtn');
        const resetBtn = document.getElementById('resetBtn');
        const liveWrap  = document.getElementById('liveWrap');
        const liveFrame = document.getElementById('liveFrame');
        const liveStatus = document.getElementById('liveStatus');

        async function post(path) {
            const res = await fetch(`/demo/${slug}/${path}`, { method: 'POST', credentials: 'same-origin' });
            return res.json();
        }

        async function start() {
            const r = await post('start');
            if (r.error) { return alert(r.error); }
            liveWrap.style.display = '';
            startBtn.style.display = 'none';
            stopBtn.style.display = '';
            resetBtn.style.display = '';
            liveFrame.src = `/demo/${slug}/live?t=${Date.now()}`;
        }

        async function stop() {
            const r = await post('stop');
            if (r.error) { return alert(r.error); }
            liveFrame.src = 'about:blank';
            liveWrap.style.display = 'none';
            startBtn.style.display = '';
            stopBtn.style.display = 'none';
            resetBtn.style.display = 'none';
        }

        async function reset() {
            const r = await post('reset');
            if (r.error) { return alert(r.error); }
            liveStatus.textContent = 'Refreshing…';
            liveFrame.src = `/demo/${slug}/live?t=${Date.now()}`;
        }

        if (startBtn) startBtn.addEventListener('click', start);
        if (stopBtn)  stopBtn.addEventListener('click', stop);
        if (resetBtn) resetBtn.addEventListener('click', reset);

        if (liveFrame) {
            liveFrame.addEventListener('load', () => { liveStatus.textContent = 'Demo running'; });
            liveFrame.addEventListener('error', () => { liveStatus.textContent = 'Demo unavailable'; });
        }
    </script>
</body>
</html>
