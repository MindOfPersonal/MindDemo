NODE_ENV=production
PORT=3050

APP_URL=https://demo.minddevelopment.nl

SESSION_SECRET=change_this_secret_key

DB_HOST=localhost
DB_PORT=3306
DB_NAME=minddemo
DB_USER=minddemo
DB_PASSWORD=change_this

DEMO_DEFAULT_TIMEOUT=30
DEMO_MAX_UPLOAD_SIZE=500
DEMO_MAX_SESSIONS=10
DEMO_SESSION_GRACE_SECONDS=60

DOCKER_SOCKET=/var/run/docker.sock

# Admin account for first setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now

# MindAgent control plane (external demo servers)
AGENT_ENABLED=true
AGENT_COMMAND_TIMEOUT_MS=60000
AGENT_IMAGE_PUSH_MAX_MB=2000
AGENT_RELEASE_URL=https://get.minddevelopment.nl/agent
AGENT_OFFLINE_AFTER_SECONDS=45
# Path to the MindDemo-agent source on this host. MindDemo packages it into a
# downloadable tarball (/agent/agent.tar.gz) and a release feed
# (/agent/releases.json), so target servers do not need the private repo.
AGENT_SOURCE_DIR=/root/projecten/Dev/MindDemo-agent

# Discord webhook logging (admin actions, sessions, security, errors, ...)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=true
DISCORD_WEBHOOK_USERNAME=MindDemo
DISCORD_WEBHOOK_AVATAR=
# Comma-separated allow-list of event keys, or '*' for everything.
# Keys: admin.login, admin.login_failed, admin.logout, demo.create, demo.update,
# demo.delete, demo.start, demo.stop, demo.restart, demo.reset, demo.public_start,
# demo.public_stop, demo.public_reset, session.create, session.end, session.expired,
# session.failed, docker.image_build, docker.container_create, docker.container_remove,
# security.rate_limit, security.csrf, error.unhandled, server.start, server.stop, audit
DISCORD_WEBHOOK_EVENTS=*
DISCORD_WEBHOOK_MIN_INTERVAL_MS=1100
DISCORD_WEBHOOK_MAX_QUEUE=200
# Optional role/user mention for high-severity events, e.g. <@&123456789>
DISCORD_WEBHOOK_MENTION=
